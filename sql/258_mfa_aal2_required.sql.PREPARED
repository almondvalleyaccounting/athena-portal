-- 258 — Require aal2 in is_active_staff(). PREPARED, NOT APPLIED.
--
-- The `.PREPARED` suffix is deliberate. This file is not a migration yet, because
-- applying it before the go-live checklist below is complete locks the entire firm out
-- of a live system. is_active_staff() is the predicate behind 402 RLS policies; it is
-- the single highest-blast-radius function in the database.
--
-- ─────────────────────────────────────────────────────────────────────────────
-- Why this is needed
-- ─────────────────────────────────────────────────────────────────────────────
--
-- MFA was enforced in the browser only. AppShell.jsx read the assurance level and
-- showed a challenge; is_active_staff() only ever asked auth.uid(). So a password-only
-- session talking straight to /rest/v1/ never met a challenge — the MFA screen was a
-- curtain, not a control. Same mistake as the 2026-08-18 findings, one layer up: a
-- check above the data layer means nothing when the predicate below it does not ask.
--
-- Worse than that, in practice. MFAChallenge.jsx had 'Remember this device for 90 days'
-- ticked by default, and AppShell short-circuited to 'ok' whenever a valid
-- mfa_trusted_devices row matched. So after one sign-in nobody ever completed a
-- challenge again, and on 2026-08-24 the position was:
--
--     10 of 11 active staff held a verified TOTP factor
--     17 live trusted-device rows, expiring to 2026-11-17
--     0 of 10 sessions were aal2
--
-- Zero. The firm had enrolled MFA and was not using it. That is now fixed on the
-- client — the device bypass is gone, so every fresh sign-in completes a challenge and
-- elevates the session. aal is a property of auth.sessions and survives token refresh,
-- so the cost is one prompt per sign-in, which is what MFA means.
--
-- This file closes the other half: making the database ask.
--
-- ─────────────────────────────────────────────────────────────────────────────
-- Go-live checklist — every box before applying
-- ─────────────────────────────────────────────────────────────────────────────
--
-- 1. ryan@tapee.io — DECIDED 2026-08-24: left active and unenrolled, and this is not
--    a blocker. He holds 0 sessions, so he cannot hold the step-4 gate open, and once
--    this migration is applied the requirement enforces itself: signing in with no
--    factor lands him on the app's enrolment screen and the database refuses him until
--    he completes it. Nothing to do here before applying.
--
-- 2. Deploy the client change that removes the trusted-device bypass (committed
--    alongside this file). Without it nobody ever reaches aal2 and applying this
--    migration locks out all eleven.
--
-- 3. Get the staff who are actually around elevated. Nobody needs to sign out —
--    mfa.verify() elevates the *existing* session, so opening Athena and entering the
--    code is enough.
--
--    Do NOT wait for people who are on leave. An absent staff member sitting at aal1
--    is not a reason to delay, because step 4 revokes their session anyway and they
--    re-authenticate cleanly on return. Waiting a week to close a live exposure in
--    order to spare someone one extra login is the wrong trade.
--
-- 4. Immediately before applying, revoke every remaining aal1 session belonging to
--    active staff:
--
--        delete from auth.sessions s
--         using public.staff_profiles sp
--         where sp.id = s.user_id and sp.is_active and s.aal <> 'aal2';
--
--    This is the step that makes the rollout safe, and it is not about tidiness.
--    Anyone still at aal1 is by definition someone who has not been through the new
--    client flow, which means their browser may still be serving the pre-deploy
--    bundle — the one that skips the challenge on a remembered device. That session
--    would hit a database that now refuses it and the user would see permission
--    errors rather than an MFA prompt. Forcing a fresh sign-in guarantees they load
--    the current bundle and get challenged properly.
--
--    Then confirm the gate is closed:
--
--        select count(*) filter (where s.aal <> 'aal2') as still_aal1
--          from auth.sessions s
--          join public.staff_profiles sp on sp.id = s.user_id
--         where sp.is_active;
--
--    still_aal1 must be 0 — which after the delete above it necessarily is. The
--    check is there to catch a session created in the gap between the two.
--
-- 5. Apply. Then immediately re-verify by impersonation, as an active staff member
--    *without* an aal claim (expect 0 rows) and with one (expect the counts staff saw
--    before). Keep a postgres session open while you do it, so you can roll back
--    without being locked out yourself.
--
-- 6. Purge mfa_trusted_devices. The rows are inert once the client no longer reads
--    them, and leaving 17 live-looking bypass tokens in a table invites someone to
--    wire them back up.
--
-- ─────────────────────────────────────────────────────────────────────────────
-- The change
-- ─────────────────────────────────────────────────────────────────────────────

begin;

-- Read the aal claim from the JWT. Absent claim is treated as aal1, never as a pass.
-- Note the deliberate asymmetry with is_staff_or_service() below: a *missing JWT
-- entirely* still passes there (pg_cron, psql, service_role) because automation has no
-- session to elevate. A JWT that is present but says aal1 is a human who has not
-- completed a challenge, and is refused.

create or replace function public.is_active_staff()
returns boolean
language sql
stable
security definer
set search_path to 'public'
as $function$
  select exists (
           select 1 from staff_profiles
            where id = auth.uid() and is_active = true
         )
     and coalesce(
           nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'aal',
           'aal1'
         ) = 'aal2';
$function$;

-- is_staff_or_service() is NOT changed and must not be. It already passes
-- service_role and no-JWT callers ahead of is_active_staff(), which is what keeps the
-- 25 cron jobs and 67 edge functions working. Reproduced here as a comment so the
-- relationship is obvious to whoever applies this:
--
--   select is_active_staff()
--       or coalesce(... ->> 'role','') = 'service_role'
--       or nullif(current_setting('request.jwt.claims', true), '') is null;
--
-- Because the aal test now lives inside is_active_staff(), automation is unaffected
-- and only human sessions are gated. That is the whole design.

commit;

-- ─────────────────────────────────────────────────────────────────────────────
-- Rollback, if step 5 goes wrong
-- ─────────────────────────────────────────────────────────────────────────────
--
-- create or replace function public.is_active_staff()
-- returns boolean language sql security definer set search_path to 'public'
-- as $function$
--   select exists (select 1 from staff_profiles where id = auth.uid() and is_active = true);
-- $function$;
